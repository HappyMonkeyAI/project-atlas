# Optional local OpenAI-compatible model adapter
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=dummy-key
OPENAI_MODEL=google/gemma-4-e2b

# Keep this false until image-input capability is verified explicitly.
ATLAS_ENABLE_VISION=false

